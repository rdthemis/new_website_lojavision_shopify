  "instructions_to_main_agent": {
    "libraries_to_install": [
      "framer-motion",
      "lucide-react",
      "@radix-ui/react-icons"
    ],
    "testing": "All interactive elements, buttons, inputs, links, and forms MUST include a data-testid attribute in kebab-case representing their role.",
    "general": "Do not create separate pages/routes. Build it as one continuous scrolling view. Use framer-motion extensively for staggered text entry and slow ken-burns zooms as dictated. Include a robust PT/EN text toggle (can be a simple state). The Shopify checkout redirect can just be a dummy action or form submission linking to Shopify."
  }
}