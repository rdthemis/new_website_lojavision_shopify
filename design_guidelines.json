{
  "project_context": {
    "app_type": "ecommerce",
    "theme": "light",
    "archetype": "3 (Pastel & Soft mixed with Vibrant Play)",
    "aesthetic": "Clean e jovem (Clean and youthful)",
    "description": "A single-page Shopify e-commerce site spanning multiple niches (Tech, Fashion, Home, Tools). Features a clean, airy, youthful design with slow-motion entry animations, a hero carousel, bento-style category menu, staggered product grid, and a sliding mini-cart."
  },
  "typography": {
    "fonts": {
      "headings": {
        "family": "Outfit, sans-serif",
        "description": "Friendly, geometric sans-serif that feels young and modern."
      },
      "body": {
        "family": "Plus Jakarta Sans, sans-serif",
        "description": "Extremely clean and highly legible sans-serif for UI elements."
      }
    },
    "scale": {
      "h1": "text-5xl md:text-6xl tracking-tight leading-none font-bold",
      "h2": "text-4xl md:text-5xl tracking-tight leading-tight font-semibold",
      "h3": "text-2xl md:text-3xl tracking-tight font-medium",
      "body": "text-base leading-relaxed",
      "small": "text-sm tracking-wide uppercase font-semibold"
    }
  },
  "colors": {
    "background": {
      "primary": "#FAFAFA",
      "secondary": "#FFFFFF",
      "tertiary": "#F3F4F6",
      "description": "Bright, airy light gray and pure white to create a clean canvas."
    },
    "text": {
      "primary": "#0A0A0A",
      "secondary": "#525252",
      "tertiary": "#A3A3A3"
    },
    "accent": {
      "primary": "#FF574D",
      "hover": "#E0463D",
      "description": "A vibrant coral/electric terracotta used as a strong, youthful accent for primary buttons and highlights."
    },
    "border": "#E5E7EB"
  },
  "spacing_and_layout": {
    "philosophy": "Generous spacing. Use p-8, p-12 to let elements breathe. No cramped containers.",
    "border_radius": "rounded-3xl for major containers, rounded-2xl for inner cards/buttons. Soft and approachable.",
    "grids": {
      "categories": "Bento-style asymmetric grid (e.g., span-2, span-1).",
      "products": "Staggered masonry or clean grid with wide gaps (gap-8 md:gap-12)."
    },
    "header": "Sticky glassmorphism header (backdrop-blur-xl bg-white/70) with subtle border-b (border-black/5)."
  },
  "motion_and_interactions": {
    "philosophy": "Slow motion entry effect is critical. Premium, gentle, staggered.",
    "entry_animation": {
      "duration": "1.2s",
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "variants": {
        "hidden": { "opacity": 0, "y": 40 },
        "visible": { "opacity": 1, "y": 0 }
      },
      "stagger_delay": 0.2
    },
    "hero_carousel": "Slow Ken-Burns effect on images (scale from 1.1 to 1.0 over 4s) with soft crossfades.",
    "hover_effects": "Subtle scale up (scale-105) for images, smooth background color transitions for buttons. No violent snaps."
  },
  "components": {
    "hero_banner": {
      "style": "Full width or large rounded container (w-[95%] mx-auto mt-4 rounded-3xl overflow-hidden). Text overlays must use a gradient scrim (bg-gradient-to-t from-black/60 to-transparent) to ensure readability."
    },
    "category_menu": {
      "style": "Visual tiles with background images, dark overlay on hover, white text. Or clean pill-shaped tabs."
    },
    "product_card": {
      "style": "Cardless or flat white cards (bg-white rounded-2xl p-4). Image takes up 70% of height. Soft shadow on hover (shadow-[0_8px_30px_rgb(0,0,0,0.04)]). Accent color add-to-cart button."
    },
    "mini_cart": {
      "style": "Slide-in drawer from the right. Glassmorphic backdrop. Clean line items with quantity controls. Prominent checkout button."
    }
  },
